# Copie para .env.local e preencha. Nunca commite o arquivo preenchido.

# --- Credenciais de demonstração (opcional) --------------------------------
# Usadas quando a pessoa escolhe "Usar credenciais de demonstração".
# Ficam só no servidor: não use o prefixo NEXT_PUBLIC_ em nenhuma delas.
# Sem estas variáveis, o modo demonstração aparece como indisponível.

# Issuer ID do Google Pay & Wallet Console (apenas números).
GOOGLE_WALLET_ISSUER_ID=

# Opção A: e-mail e chave privada da conta de serviço.
# A chave vai em uma linha, entre aspas, com \n no lugar das quebras de linha.
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# Opção B: o JSON inteiro da chave, em uma linha (substitui a opção A).
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# Máximo de passes de demonstração por visitante, por hora (padrão: 20).
# WALLET_DEMO_MAX_PER_HOUR=20

# --- Marca (opcional) -------------------------------------------------------
# Valores iniciais da interface. Tudo pode ser alterado no formulário.
# APP_NAME=Google Wallet Studio
# WALLET_DEFAULT_ISSUER_NAME=Minha Empresa
# WALLET_DEFAULT_BACKGROUND_COLOR=#1a73e8
# WALLET_DEFAULT_LOGO_URL=https://exemplo.com/logo.png
# WALLET_DEFAULT_HERO_IMAGE_URL=https://exemplo.com/banner.png
